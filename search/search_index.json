{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\ud83d\udc4b 363\u7684\u6df7\u4e71\u7a7a\u95f4","text":"<p>\u667a\u8005\u4e50\u6c34\uff0c\u4ec1\u8005\u4e50\u5c71</p>"},{"location":"#_1","title":"\ud83d\uddfa\ufe0f \u8fd9\u91cc\u6709\u4ec0\u4e48","text":"<ul> <li> <p>\ud83d\udcda \u5b66\u4e60\u7b14\u8bb0</p> <p>\u8bb0\u5f55\u5b66\u4e60\u8fc7\u7a0b\u4e2d\u7684\u77e5\u8bc6\u6c89\u6dc0\uff0c\u5305\u62ec\u7f16\u7a0b\u3001\u6570\u5b66\u7b49</p> <p>\u2192 \u8fdb\u5165\u7b14\u8bb0</p> </li> <li> <p>\ud83d\udee0\ufe0f \u4f5c\u54c1\u96c6</p> <p>\u6211\u505a\u8fc7\u7684\u9879\u76ee\u548c\u5c0f\u4f5c\u54c1</p> <p>\u2192 \u67e5\u770b\u4f5c\u54c1</p> </li> <li> <p>\u270d\ufe0f \u535a\u5ba2</p> <p>\u968f\u60f3\u3001\u603b\u7ed3\u3001\u5b66\u4e60\u5fc3\u5f97</p> <p>\u2192 \u8bfb\u535a\u5ba2</p> </li> <li> <p>\ud83d\ude4b \u5173\u4e8e\u6211</p> <p>\u6211\u662f\u8c01\uff0c\u6211\u5728\u505a\u4ec0\u4e48</p> <p>\u2192 \u4e86\u89e3\u6211</p> </li> </ul>"},{"location":"#_2","title":"\ud83d\udccc \u6700\u8fd1\u66f4\u65b0","text":"<ul> <li>\ud83c\udd95 \u7f51\u7ad9\u6b63\u5f0f\u4e0a\u7ebf\uff01</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e\u6211","text":"<p>\u5185\u5bb9\u5373\u5c06\u5b8c\u5584...</p>"},{"location":"blog/","title":"\u535a\u5ba2","text":"<p>\u5185\u5bb9\u5373\u5c06\u5b8c\u5584...</p>"},{"location":"notes/","title":"\u5b66\u4e60\u7b14\u8bb0","text":"<p>\u8bb0\u5f55\u5b66\u4e60\u8fc7\u7a0b\u4e2d\u7684\u77e5\u8bc6\u6c89\u6dc0\u3002</p>"},{"location":"notes/#_2","title":"\u76ee\u5f55","text":"<ul> <li> <p>git \u547d\u4ee4\u901f\u67e5</p> <p>\u5e38\u7528 git \u547d\u4ee4\u6c47\u603b\uff0c\u5feb\u901f\u67e5\u9605</p> <p>\u2192 \u67e5\u770b</p> </li> <li> <p>ROS2 \u77e5\u8bc6\u624b\u518c</p> <p>ROS2 \u5b66\u4e60\u7b14\u8bb0\u4e0e\u5e38\u7528\u77e5\u8bc6\u70b9</p> <p>\u2192 \u67e5\u770b</p> </li> <li> <p>\u5206\u6570\u6784\u6210</p> <p>\u81ea\u52a8\u63a7\u5236\u539f\u7406\u8bfe\u7a0b\u8981\u6c42\u4e0e\u6210\u7ee9\u6784\u6210</p> <p>\u2192 \u67e5\u770b</p> </li> <li> <p>Claude Code \u4f7f\u7528\u624b\u518c</p> <p>Claude Code \u6838\u5fc3\u672f\u8bed\u4e0e\u5b9e\u6218\u64cd\u4f5c\u6307\u5357</p> <p>\u2192 \u67e5\u770b</p> </li> </ul>"},{"location":"notes/claude%20code/","title":"Claude Code\u4f7f\u7528","text":"<p>Claude Code \u6838\u5fc3\u672f\u8bed\u4e0e\u5b9e\u6218\u64cd\u4f5c\u624b\u518c</p> <p>\u6b22\u8fce\u6765\u5230 AI \u539f\u751f\u7f16\u7a0b\u7684\u65b0\u65f6\u4ee3\u3002\u4f5c\u4e3a\u4f60\u7684\u6280\u672f\u5e03\u9053\u5e08\uff0c\u6211\u5c06\u5e26\u4f60\u6df1\u5ea6\u89e3\u6790 Claude Code\u2014\u2014\u8fd9\u6b3e\u7531 Anthropic \u63a8\u51fa\u7684\u547d\u4ee4\u884c AI \u4ee3\u7406\uff08Agent\uff09\u5de5\u5177\u3002\u5b83\u4e0d\u53ea\u662f\u4e00\u4e2a\u7b80\u5355\u7684\u5bf9\u8bdd\u6846\uff0c\u800c\u662f\u4e00\u4e2a\u80fd\u76f4\u63a5\u63a5\u7ba1\u7ec8\u7aef\u3001\u6df1\u5ea6\u7406\u89e3\u4e07\u884c\u7ea7\u4ee3\u7801\u4e0a\u4e0b\u6587\u5e76\u81ea\u4e3b\u6267\u884c\u5de5\u7a0b\u4efb\u52a1\u7684\u201c\u6570\u5b57\u5f00\u53d1\u8005\u201d\u3002</p> <ol> <li>\u5feb\u901f\u8d77\u6b65\uff1aClaude Code \u7684\u4e09\u79cd\u201c\u6027\u683c\u201d (\u8fd0\u884c\u6a21\u5f0f)</li> </ol> <p>\u7406\u89e3 Claude Code \u7684\u7b2c\u4e00\u6b65\u662f\u5b66\u4f1a\u6839\u636e\u4efb\u52a1\u7684\u590d\u6742\u5ea6\u5207\u6362\u5176\u201c\u5de5\u4f5c\u72b6\u6001\u201d\u3002\u76f2\u76ee\u4f7f\u7528\u9ed8\u8ba4\u914d\u7f6e\u5f80\u5f80\u4f1a\u9020\u6210\u6548\u7387\u6d6a\u8d39\uff0c\u8d44\u6df1\u5f00\u53d1\u8005\u4f1a\u6839\u636e\u5177\u4f53\u573a\u666f\u5728\u4ee5\u4e0b\u4e09\u79cd\u6a21\u5f0f\u95f4\u4e1d\u6ed1\u5207\u6362\uff1a</p> <p>\u6a21\u5f0f\u540d\u79f0    \u6838\u5fc3\u7279\u70b9    \u4e13\u5bb6\u7ea7\u9002\u7528\u573a\u666f \u9ed8\u8ba4\u6a21\u5f0f (Default)  \u6807\u51c6\u4ea4\u4e92\uff0c\u6bcf\u4e00\u6b65\u64cd\u4f5c\u3001\u6587\u4ef6\u5199\u5165\u5747\u9700\u4eba\u5de5\u786e\u8ba4\u3002  \u63a2\u7d22\u6027\u63a8\u7406\uff1a\u5982\u5728\u964c\u751f\u7684\u8001\u65e7\u4ee3\u7801\u5e93\u4e2d\u5b9a\u4f4d\u6f5c\u5728\u7684\u5185\u5b58\u6cc4\u6f0f\uff0c\u6216\u8fdb\u884c\u96f6\u6563\u7684\u4ee3\u7801\u54a8\u8be2\u3002 \u81ea\u52a8\u6a21\u5f0f (Auto) \u76ee\u6807\u5bfc\u5411\uff0cAI \u4f1a\u6839\u636e\u65e2\u5b9a\u76ee\u6807\u81ea\u4e3b\u8fdb\u884c\u591a\u8f6e\u8fed\u4ee3\u6267\u884c\u3002  \u786e\u5b9a\u6027\u4fee\u590d\uff1a\u5df2\u77e5 Bug \u7684\u81ea\u52a8\u5316\u4fee\u590d\u3001\u5355\u5143\u6d4b\u8bd5\u8865\u5168\u3001\u6216\u8005\u7b80\u5355\u4e14\u91cd\u590d\u7684\u529f\u80fd\u91cd\u6784\u3002 \u89c4\u5212\u6a21\u5f0f (Plan) \u67b6\u6784\u7ea7\u601d\u8003\u3002\u5148\u751f\u6210\u8be6\u5c3d\u7684\u6267\u884c\u84dd\u56fe\u4f9b\u5ba1\u6838\uff0c\u4e0d\u76f4\u63a5\u52a8\u4ee3\u7801\u3002 \u590d\u6742\u5de5\u7a0b\u4efb\u52a1\uff1a\u8de8\u6a21\u5757\u7684\u5927\u89c4\u6a21\u91cd\u6784\u3001\u65b0\u529f\u80fd\u6a21\u5757\u7684\u67b6\u6784\u8bbe\u8ba1\u3001\u6d89\u53ca\u591a\u6587\u4ef6\u5173\u8054\u7684\u903b\u8f91\u4fee\u6539\u3002</p> <p>\ud83d\udca1 \u6838\u5fc3\u6d1e\u5bdf\uff1a \u533a\u5206 Default \u4e0e Auto \u7684\u5173\u952e\u5728\u4e8e\u4f60\u662f\u5426\u613f\u610f\u201c\u653e\u6743\u201d\u3002\u5bf9\u4e8e\u521d\u5b66\u8005\uff0cPlan \u6a21\u5f0f \u662f\u5904\u7406\u903b\u8f91\u4ea4\u7ec7\u96be\u9898\u7684\u4fdd\u62a4\u4f1e\uff0c\u5b83\u80fd\u5f3a\u8feb AI \u5728\u52a8\u624b\u524d\u8fdb\u884c\u5168\u5c40\u601d\u8003\uff0c\u4ece\u800c\u6781\u5927\u51cf\u5c11\u65e0\u6548\u7684 Token \u6d88\u8017\u548c\u4ee3\u7801\u8fd4\u5de5\u3002</p> <ol> <li>\u6df1\u5ea6\u62c6\u89e3\uff1aMCP\u3001Agent Skill \u4e0e SubAgent \u7684\u672c\u8d28\u533a\u522b</li> </ol> <p>\u8fd9\u4e09\u4e2a\u672f\u8bed\u6784\u6210\u4e86 Claude Code \u7684\u80fd\u529b\u9aa8\u67b6\u3002\u5bf9\u4e8e\u5f00\u53d1\u8005\u6765\u8bf4\uff0c\u7406\u89e3\u5b83\u4eec\u7684\u7269\u7406\u610f\u4e49\u51b3\u5b9a\u4e86\u4f60\u80fd\u5426\u771f\u6b63\u9a7e\u9a6d\u8fd9\u4e2a Agent\u3002</p> <p>\u6838\u5fc3\u5b9a\u4e49</p> <ul> <li>MCP (Model Context Protocol)\uff1a \u5b83\u662f Claude \u7684\u201c\u773c\u775b\u201d\u3002\u4f5c\u4e3a\u4e00\u4e2a\u901a\u7528\u7684\u5916\u90e8\u8fde\u63a5\u534f\u8bae\uff0c\u5b83\u6253\u7834\u4e86 AI \u7684\u4fe1\u606f\u5b64\u5c9b\u3002\u901a\u8fc7\u8fde\u63a5 Figma MCP Server\uff0cClaude \u80fd\u76f4\u63a5\u201c\u770b\u5230\u201d\u8bbe\u8ba1\u7a3f\u7684\u53c2\u6570\uff1b\u8fde\u63a5 GitHub MCP\uff0c\u5b83\u80fd\u8de8\u4ed3\u5e93\u68c0\u7d22 Issues\u3002\u5b83\u8d1f\u8d23\u89e3\u51b3\u201c\u4fe1\u606f\u4ece\u54ea\u6765\u201d\u7684\u95ee\u9898\u3002</li> <li>Agent Skill\uff1a \u5b83\u662f Claude \u7684\u201c\u624b\uff08\u52a8\u8bcd\u5b9a\u4e49\uff09\u201d\u3002Skill \u662f\u539f\u5b50\u5316\u7684\u80fd\u529b\u6269\u5c55\u5305\uff0c\u672c\u8d28\u4e0a\u662f\u4e3a Agent \u5b9a\u4e49\u7684\u7279\u5b9a\u5de5\u5177\uff08Tools\uff09\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u4e3a\u5b83\u5b9a\u4e49\u4e00\u4e2a\u201c\u8fd0\u884c\u7279\u5b9a\u52a0\u89e3\u5bc6\u6d4b\u8bd5\u201d\u7684 Skill\uff0c\u8ba9\u5b83\u638c\u63e1\u539f\u672c\u4e0d\u5177\u5907\u7684\u4e13\u4e1a\u64cd\u4f5c\u3002</li> <li>SubAgent (\u5b50\u4ee3\u7406)\uff1a \u5b83\u662f Claude \u7684\u201c\u5206\u8eab/\u5e2e\u624b\u201d\u3002\u5f53\u4e3b\u4ee3\u7406\u9762\u5bf9\u7684\u5de5\u7a0b\u91cf\u7a81\u7834\u4e86\u4e0a\u4e0b\u6587\u7a97\u53e3\u9650\u5236\uff0c\u6216\u8005\u4efb\u52a1\u8fc7\u4e8e\u7410\u788e\u65f6\uff0c\u5b83\u4f1a\u514b\u9686\u51fa\u4e00\u4e2a\u5177\u5907\u72ec\u7acb\u6743\u9650\u7684\u5b50\u5b9e\u4f8b\u3002</li> </ul> <p>\u4e13\u5bb6\u7ea7\u5bf9\u6bd4\uff1a\u80fd\u529b\u8fb9\u754c\u4e00\u89c8</p> <p>\u6982\u5ff5  \u6838\u5fc3\u529f\u80fd    \u6df1\u5ea6\u8fa8\u6790 MCP \u5916\u90e8\u8fde\u63a5\u5668   \u5173\u4e4e\u5916\u90e8\u4fe1\u606f\u83b7\u53d6\u3002\u8ba9 AI \u5177\u5907\u8bfb\u53d6\u975e\u672c\u5730\u6570\u636e\u7684\u80fd\u529b\u3002 Agent Skill \u81ea\u8eab\u80fd\u529b\u589e\u5f3a  \u5173\u4e4e\u539f\u5b50\u80fd\u529b\u5b9a\u4e49\u3002\u7ed9 AI \u589e\u52a0\u4e00\u4e2a\u7279\u5b9a\u7684\u201c\u52a8\u4f5c\u201d\u6216\u201c\u6307\u4ee4\u201d\u3002 SubAgent    \u590d\u6742\u4efb\u52a1\u5206\u5de5  \u5173\u4e4e\u6743\u9650\u59d4\u6d3e\u4e0e\u6cbb\u7406\u3002\u4e3a\u4e86\u9632\u6b62\u4e3b\u5bf9\u8bdd\u4e0a\u4e0b\u6587\u6ea2\u51fa\uff0c\u5c06\u5b50\u4efb\u52a1\u5265\u79bb\u7ed9\u65b0\u5b9e\u4f8b\u5904\u7406\u3002</p> <p>\ud83d\udca1 \u6838\u5fc3\u6d1e\u5bdf\uff1a \u5728\u5904\u7406\u4e07\u884c\u4ee3\u7801\u7684\u5927\u578b\u9879\u76ee\u65f6\uff0cSubAgent \u7684\u5f15\u5165\u81f3\u5173\u91cd\u8981\u3002\u5b83\u4e0d\u4ec5\u662f\u5206\u5de5\uff0c\u66f4\u662f\u4e3a\u4e86\u4fdd\u62a4\u4e0a\u4e0b\u6587\uff08Context Window\uff09\u3002\u901a\u8fc7\u5c06\u5b50\u4efb\u52a1\u5916\u5305\uff0c\u4e3b\u4ee3\u7406\u53ef\u4ee5\u4fdd\u6301\u6e05\u6670\u7684\u67b6\u6784\u89c6\u89d2\uff0c\u800c\u4e0d\u88ab\u7ec6\u679d\u672b\u8282\u7684\u5b9e\u73b0\u4ee3\u7801\u6df9\u6ca1\u3002</p> <ol> <li>\u5b9e\u6218\u6307\u4ee4\uff1a\u63a5\u7ba1\u4f60\u7684\u7ec8\u7aef\u5f00\u53d1\u6d41\u7a0b</li> </ol> <p>Claude Code \u7684\u5f3a\u5927\u6e90\u4e8e\u5b83\u5bf9\u7ec8\u7aef\uff08Terminal\uff09\u7684\u6df1\u5ea6\u63a7\u5236\u529b\u3002\u5b83\u4e0d\u662f\u5728\u201c\u5199\u4ee3\u7801\u5efa\u8bae\u201d\uff0c\u800c\u662f\u5728\u201c\u76f4\u63a5\u64cd\u4f5c\u73af\u5883\u201d\u3002</p> <p>\u7ec8\u7aef\u63a7\u5236\u4e0e Bash \u6267\u884c</p> <p>\u4f60\u53ef\u4ee5\u76f4\u63a5\u5728\u5bf9\u8bdd\u4e2d\u4f7f\u7528\u81ea\u7136\u8bed\u8a00\u9a71\u52a8 Bash \u547d\u4ee4\uff0cClaude \u4f1a\u81ea\u52a8\u5c06\u5176\u8f6c\u5316\u4e3a\u53ef\u6267\u884c\u8bed\u53e5\uff1a</p>"},{"location":"notes/claude%20code/#claude","title":"\u793a\u4f8b\uff1a\u8981\u6c42 Claude \u81ea\u52a8\u5316\u5904\u7406\u6d41\u7a0b","text":"<p>claude \"\u67e5\u627e src \u76ee\u5f55\u4e0b\u6240\u6709\u672a\u4f7f\u7528\u7684\u5bfc\u51fa\u51fd\u6570\uff0c\u5e76\u7f16\u5199\u4e00\u4e2a\u5220\u9664\u811a\u672c\"</p> <p>\u7279\u6b8a\u6743\u9650\uff1a\u751f\u4ea7\u529b\u52a0\u901f\u5668</p> <p>\u5728\u4fe1\u4efb\u7684\u672c\u5730\u73af\u5883\u6216\u5927\u89c4\u6a21\u91cd\u6784\u4e2d\uff0c\u9891\u7e41\u7684 y/n \u786e\u8ba4\u4f1a\u5f7b\u5e95\u51fb\u788e\u5f00\u53d1\u5fc3\u6d41\u3002</p> <ul> <li>\u6307\u4ee4\uff1a dangerously-skip-permissions</li> <li>\u4e13\u5bb6\u5e94\u7528\u573a\u666f\uff1a \u5f53\u4f60\u9700\u8981\u8fdb\u884c\u5168\u5c40\u53d8\u91cf\u91cd\u547d\u540d\u6216\u81ea\u52a8\u5316\u8fc1\u79fb 100+ \u4e2a\u6587\u4ef6\u65f6\uff0c\u8be5\u6307\u4ee4\u662f\u5fc5\u9009\u9879\u3002\u5b83\u540c\u6837\u9002\u7528\u4e8e CI/CD \u81ea\u52a8\u5316\u6d41\u6c34\u7ebf\uff0c\u8ba9 AI \u5728\u65e0\u4eba\u503c\u5b88\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u65e2\u5b9a\u4efb\u52a1\u3002</li> <li>\u26a0\ufe0f \u5b89\u5168\u8b66\u793a\uff1a \u6743\u529b\u8d8a\u5927\u8d23\u4efb\u8d8a\u5927\uff0c\u8bf7\u52a1\u5fc5\u786e\u4fdd\u5728 Git \u72b6\u6001\u5e72\u51c0\u7684\u73af\u5883\u4e0b\u4f7f\u7528\uff0c\u4ee5\u4fbf\u968f\u65f6\u56de\u6eda\u3002</li> </ul> <p>\u540e\u53f0\u4efb\u52a1\u7ba1\u7406 (Background Tasks)</p> <p>Claude \u5141\u8bb8\u4f60\u5728\u5bf9\u8bdd\u7a97\u53e3\u542f\u52a8\u8017\u65f6\u4efb\u52a1\uff08\u5982\u7f16\u8bd1\u3001\u957f\u6d4b\u8bd5\u96c6\uff09\u3002</p> <ul> <li>\u4f60\u53ef\u4ee5\u8ba9\u5b83\uff1a\u201c\u5728\u540e\u53f0\u8fd0\u884c\u6d4b\u8bd5\uff0c\u5982\u679c\u62a5\u9519\u4e86\u7acb\u523b\u6253\u65ad\u6211\uff0c\u6ca1\u62a5\u9519\u5c31\u7ee7\u7eed\u4f18\u5316\u6587\u6863\u3002\u201d\u8fd9\u79cd\u5e76\u884c\u5fc3\u6d41\u662f\u8d44\u6df1 AI \u7a0b\u5e8f\u5458\u7684\u6838\u5fc3\u4f18\u52bf\u3002</li> </ul> <ol> <li>\u8bb0\u5fc6\u4e0e\u56de\u6eaf\uff1a\u7ba1\u7406\u4e0a\u4e0b\u6587\u4e0e\u9879\u76ee\u72b6\u6001</li> </ol> <p>AI \u7684\u201c\u77ed\u671f\u8bb0\u5fc6\u201d\u4f9d\u8d56\u5bf9\u8bdd\u6d41\uff0c\u800c\u201c\u957f\u671f\u8bb0\u5fc6\u201d\u5219\u4f9d\u8d56\u89c4\u5219\u914d\u7f6e\u3002</p> <ul> <li>\u231b \u7248\u672c\u56de\u6eda (Rewind)\uff1a\u8fd9\u662f\u5f00\u53d1\u8005\u7684\u201c\u65f6\u5149\u673a\u201d\u3002\u5f53 AI \u7684\u591a\u6b65\u4fee\u6539\u5bfc\u81f4\u7a0b\u5e8f\u5d29\u6e83\u65f6\uff0c\u4f7f\u7528 Rewind \u53ef\u4ee5\u7cbe\u51c6\u56de\u6eaf\u5230\u4efb\u4f55\u4e00\u4e2a\u5386\u53f2\u8282\u70b9\u3002</li> <li>\ud83d\udd04 \u4f1a\u8bdd\u6062\u590d (Resume)\uff1a\u901a\u8fc7 resume \u547d\u4ee4\uff0c\u4f60\u53ef\u4ee5\u627e\u56de\u6628\u5929\u7684\u601d\u8def\uff0c\u65e0\u9700\u91cd\u65b0\u5582\u5165\u80cc\u666f\u4fe1\u606f\uff0c\u4fdd\u6301\u5f00\u53d1\u7684\u8fde\u7eed\u6027\u3002</li> <li>\ud83d\udcd3 \u9879\u76ee\u8bb0\u5fc6 (CLAUDE.md)\uff1a\u8fd9\u662f\u7ed9 Claude \u7684\u201c\u9879\u76ee\u8bf4\u660e\u4e66\u201d\u3002\u4f60\u5e94\u5728\u6b64\u6587\u4ef6\u4e2d\u5199\u5165\u9879\u76ee\u7684\u7f16\u7801\u89c4\u8303\u3001\u6280\u672f\u6808\u504f\u597d\uff08\u5982\uff1a\u5fc5\u987b\u4f7f\u7528 Tailwind\uff09\u4ee5\u53ca\u907f\u5751\u6307\u5357\u3002Claude \u6bcf\u6b21\u542f\u52a8\u90fd\u4f1a\u4f18\u5148\u9605\u8bfb\u3002</li> </ul> <p>\u9ad8\u6548\u7ba1\u7406\u4e0a\u4e0b\u6587\u7684 3 \u4e2a\u5173\u952e\u52a8\u4f5c</p> <ol> <li>\ud83e\uddf9 \u5b9a\u671f\u6e05\u7406 (Clear/Compact)\uff1a\u5f53\u5bf9\u8bdd\u5386\u53f2\u8fc7\u957f\u5bfc\u81f4\u54cd\u5e94\u5ef6\u8fdf\u65f6\uff0c\u4e3b\u52a8\u6267\u884c\u6e05\u7406\uff0c\u4fdd\u7559\u6838\u5fc3\u7ed3\u8bba\u3002</li> <li>\ud83d\udccc \u72b6\u6001\u540c\u6b65\uff1a\u5728\u957f\u65f6\u95f4\u5bf9\u8bdd\u540e\uff0c\u8981\u6c42 Claude \u603b\u7ed3\u5f53\u524d\u8fdb\u5ea6\u5e76\u5199\u5165 CLAUDE.md\u3002</li> <li>\u2696\ufe0f \u6743\u9650\u4e0b\u653e\uff1a\u5229\u7528 dangerously-skip-permissions \u5904\u7406\u7410\u788e\u4fee\u6539\uff0c\u4fdd\u6301\u4e3b\u5bf9\u8bdd\u6d41\u7684\u7b80\u6d01\u3002</li> </ol> <ol> <li> <p>\u9ad8\u7ea7\u6269\u5c55\uff1a\u591a\u6a21\u6001\u5904\u7406\u4e0e\u81ea\u52a8\u5316 Hook</p> </li> <li> <p>\u591a\u6a21\u6001\u89c6\u89c9\u5904\u7406\uff1aClaude Code \u80fd\u591f\u201c\u9605\u8bfb\u201d\u56fe\u7247\u3002\u4f60\u53ef\u4ee5\u76f4\u63a5\u8f93\u5165\u62a5\u9519\u622a\u56fe\u6216 UI \u8bbe\u8ba1\u56fe\u3002</p> </li> <li>Figma + MCP \u5b9e\u6218\uff1a\u6700\u9876\u7ea7\u7684\u73a9\u6cd5\u662f\u5229\u7528 Figma MCP \u63d0\u53d6\u8bbe\u8ba1\u6807\u8bb0\uff08Tokens\uff09\uff0c\u7ed3\u5408 Claude \u7684\u591a\u6a21\u6001\u80fd\u529b\uff0c\u5b9e\u73b0\u201c\u770b\u4e00\u773c\u8bbe\u8ba1\u7a3f\uff0c\u76f4\u63a5\u4ea7\u51fa\u7b26\u5408\u89c4\u8303\u7684 React \u7ec4\u4ef6\u201d\u3002</li> <li>Hook \u673a\u5236\uff1a\u5c06 Claude \u96c6\u6210\u5230 Git \u5de5\u4f5c\u6d41\u4e2d\u3002\u4f8b\u5982\u914d\u7f6e\u4e00\u4e2a pre-commit Hook\uff0c\u8ba9 Claude \u5728\u4f60\u63d0\u4ea4\u4ee3\u7801\u524d\u81ea\u52a8\u5ba1\u67e5\u6f5c\u5728\u7684\u903b\u8f91\u7f3a\u9677\u3002</li> </ol> <p>\ud83d\ude80 \u5b9e\u6218\u7ed3\u8bed</p> <p>\u4ece\u7b80\u5355\u7684 Bash \u547d\u4ee4\u8d77\u6b65\uff0c\u9010\u6b65\u5c1d\u8bd5\u5728\u590d\u6742\u4efb\u52a1\u4e2d\u8c03\u7528 SubAgent\u3002\u4f60\u4f1a\u53d1\u73b0\uff0cClaude Code \u4e0d\u53ea\u662f\u4e00\u4e2a\u5de5\u5177\uff0c\u5b83\u662f\u4e00\u4e2a\u53ef\u4ee5\u968f\u7740 CLAUDE.md \u7684\u5b8c\u5584\u800c\u4e0d\u65ad\u8fdb\u5316\u7684\u201c\u6570\u5b57\u5408\u4f19\u4eba\u201d\u3002</p> <p>\ud83d\udca1 \u7ec8\u6781\u6d1e\u5bdf\uff1a \u771f\u6b63\u7684\u751f\u4ea7\u529b\u98de\u8dc3\uff0c\u53d1\u751f\u5728 \u591a\u6a21\u6001\u80fd\u529b \u4e0e \u5916\u90e8\u534f\u8bae (MCP) \u7684\u7ed3\u5408\u70b9\u4e0a\u3002\u8fd9\u6807\u5fd7\u7740\u5f00\u53d1\u6a21\u5f0f\u4ece\u201c\u624b\u52a8\u642c\u8fd0\u4ee3\u7801\u201d\u8f6c\u53d8\u4e3a\u201c\u9ad8\u9636\u903b\u8f91\u7f16\u6392\u201d\u3002\u73b0\u5728\uff0c\u53bb\u7ec8\u7aef\u5f00\u542f\u4f60\u7684\u7b2c\u4e00\u4e2a\u6307\u4ee4\uff0c\u611f\u53d7 AI \u4ee3\u7406\u63a5\u7ba1\u751f\u4ea7\u529b\u7684\u9707\u64bc\u5427\uff01</p>"},{"location":"notes/course%20score/","title":"\u81ea\u52a8\u63a7\u5236\u539f\u7406","text":""},{"location":"notes/course%20score/#_2","title":"\u8bfe\u7a0b\u8981\u6c42\uff1a","text":"<ul> <li>\u6bcf\u5468\u4e00\u4e0a\u8bfe\u524d\u4ea4\u4f5c\u4e1a\uff0c\u4e0d\u8981\u8fdf\u4ea4</li> <li>\u5e73\u65f6\u6210\u7ee9\uff08\u4f5c\u4e1a\uff0c\u5c0f\u6d4b\uff0c\u5b9e\u9a8c\u62a5\u544a\uff09\uff1a40-60%</li> <li>\u671f\u672b\u6210\u7ee9\uff1a60-40%</li> <li>\u5b9e\u9a8c\uff08\u6708\u7259\u697c\uff09\uff1a<ul> <li>\u4eff\u771f\uff1a\u627e\u52a9\u6559\uff0cmatlab</li> <li>\u5b9e\u9a8c\u7bb1\u5b9e\u9a8c\uff1a\u66f9\u8001\u5e08</li> </ul> </li> </ul>"},{"location":"notes/course%20score/#_3","title":"\u6570\u503c\u8ba1\u7b97\u65b9\u6cd5","text":""},{"location":"notes/course%20score/#_4","title":"\u6570\u636e\u7ed3\u6784\u57fa\u7840","text":""},{"location":"notes/course%20score/#_5","title":"\u7cfb\u7edf\u5efa\u6a21\u4e0e\u4eff\u771f","text":"<p>\u5e73\u65f6\uff08\u8bfe\u5802\u8868\u73b0 + \u968f\u5802\u6d4b\u8bd5\uff09\u5360 40%\uff0c\u671f\u672b\u8003\u8bd5\u5360 60%\uff1b\u6d4b\u8bd5\u901a\u8fc7\u201c\u5b66\u5728\u6d59\u5927\u201d\u63d0\u4ea4\uff0c\u5f53\u5802\u5b8c\u6210\u7cfb\u6570\u66f4\u9ad8\u3002</p>"},{"location":"notes/git/","title":"git \u547d\u4ee4\u884c\u6982\u89c8","text":""},{"location":"notes/git/#_1","title":"\u521d\u59cb\u914d\u7f6e","text":"<pre><code>git config --global user.name \"mulberry63\"\ngit config --global user.email \"1677815534@qq.com\"\ngit config --global init.defaultBranch master #\u5c06\u9ed8\u8ba4\u7684\u540d\u79f0\u4fee\u6539\u4e3amaster\n\ngit init #\u521d\u59cb\u5316\u4ed3\u5e93\n</code></pre> <p>\u521d\u59cb\u5316\u4ee5\u540e\uff0c\u5728linux\u91cc\u9762\u4ee5 \u201c.\u201d \u5f00\u5934\u7684\u6587\u4ef6\u548c\u6587\u4ef6\u5939\u90fd\u5c5e\u4e8e\u9690\u85cf\u76ee\u5f55\uff0c\u4f7f\u7528<code>ls-a</code>\u624d\u80fd\u67e5\u770b</p>"},{"location":"notes/git/#_2","title":"\u63d0\u4ea4\u4ee3\u7801","text":""},{"location":"notes/git/#add","title":"\u4f7f\u7528 add \u6682\u5b58","text":"<ul> <li>\u6682\u5b58\u5355\u4e2a\u6587\u4ef6\uff1a</li> </ul> <pre><code>git add src/status_interfaces/package.xml \n</code></pre> <ul> <li>\u6682\u5b58\u67d0\u4e2a\u76ee\u5f55\uff1a</li> </ul> <p><pre><code>git add src \n</code></pre> - \u6682\u5b58\u5f53\u524d\u7ec8\u7aef\u76ee\u5f55\u7684\u6240\u6709\u6587\u4ef6\uff1a</p> <p><pre><code>git add . \n</code></pre> - \u5c06\u6682\u5b58\u533a\u6240\u6709\u6587\u4ef6\u8e22\u51fa\uff1a</p> <pre><code>git reset\n</code></pre> <p>\u6ce8\uff1a\u5de5\u7a0b\u4e2d\uff0cbuild\uff0c install\uff0c log\u90fd\u662f\u7f16\u8bd1\u4ea7\u751f\u7684\u76ee\u5f55\uff0c\u4e0d\u5efa\u8bae\u63d0\u4ea4\u3002\u53ea\u63d0\u4ea4src\u5373\u53ef</p>"},{"location":"notes/git/#commit-git","title":"\u4f7f\u7528 commit \u63d0\u4ea4\u5230 git \u4ed3\u5e93","text":"<ul> <li>\u628a\u6682\u5b58\u533a\u7684\u4ee3\u7801\u63d0\u4ea4\uff0c\u5e76\u6279\u6ce8 <pre><code>git commit -m \"\u5b8c\u6210\u72b6\u6001\u53d1\u5e03\u4e0e\u663e\u793a\u529f\u80fd\"\n</code></pre></li> <li> <p>\u67e5\u770b\u63d0\u4ea4\u7684\u5386\u53f2\u65e5\u5fd7\uff1a <pre><code>git log\n</code></pre></p> </li> <li> <p>\u521b\u5efa .gitignore \u6587\u4ef6\uff0c\u5728add\u7684\u65f6\u5019\u5c31\u4f1a\u5ffd\u7565\u4ee5\u4e0b\u6587\u4ef6or\u76ee\u5f55</p> </li> </ul> <p>\u4f8b\u5982\uff1a <pre><code>build/\ninstall/\nlog/\n</code></pre></p>"},{"location":"notes/ros2/","title":"ROS2 \u77e5\u8bc6\u624b\u518c","text":"<p>\u5feb\u901f\u53c2\u8003\uff1a\u5de5\u4f5c\u7a7a\u95f4\u7ba1\u7406\u3001\u529f\u80fd\u5305\u521b\u5efa\u3001\u8282\u70b9\u7f16\u5199</p>"},{"location":"notes/ros2/#_1","title":"\u76ee\u5f55","text":"<ul> <li>\u521b\u5efa\u5de5\u4f5c\u7a7a\u95f4</li> <li>\u521b\u5efa\u529f\u80fd\u5305</li> <li>\u6784\u5efa\u529f\u80fd\u5305</li> <li>C++ \u8282\u70b9</li> <li>Python \u8282\u70b9</li> </ul>"},{"location":"notes/ros2/#_2","title":"\u521b\u5efa\u5de5\u4f5c\u7a7a\u95f4","text":""},{"location":"notes/ros2/#1","title":"1. \u521b\u5efa\u76ee\u5f55\u7ed3\u6784","text":"<pre><code>mkdir -p ~/ros2_ws/src\ncd ~/ros2_ws\n</code></pre>"},{"location":"notes/ros2/#2","title":"2. \u521d\u59cb\u5316\u5de5\u4f5c\u7a7a\u95f4\uff08\u53ef\u9009\uff09","text":"<pre><code>colcon build\nsource install/setup.bash\n</code></pre>"},{"location":"notes/ros2/#_3","title":"\u521b\u5efa\u529f\u80fd\u5305","text":""},{"location":"notes/ros2/#c","title":"C++ \u529f\u80fd\u5305","text":"<pre><code>cd ~/ros2_ws/src\nros2 pkg create my_cpp_pkg \\\n  --build-type ament_cmake \\\n  --dependencies rclcpp std_msgs \\\n  --license Apache-2.0\n</code></pre>"},{"location":"notes/ros2/#python","title":"Python \u529f\u80fd\u5305","text":"<pre><code>cd ~/ros2_ws/src\nros2 pkg create my_py_pkg \\\n  --build-type ament_python \\\n  --dependencies rclpy std_msgs \\\n  --license Apache-2.0\n</code></pre>"},{"location":"notes/ros2/#_4","title":"\u81ea\u5b9a\u4e49\u63a5\u53e3\u529f\u80fd\u5305","text":"<pre><code>cd ~/ros2_ws/src\nros2 pkg create status_interfaces \\\n  --build-type ament_cmake \\\n  --dependencies rosidl_default_generators builtin_interfaces \\\n  --license Apache-2.0\n</code></pre> <p>\u8bf4\u660e\uff1a <code>--dependencies</code> \u53c2\u6570\u6307\u5b9a\u529f\u80fd\u5305\u4f9d\u8d56\u9879</p>"},{"location":"notes/ros2/#_5","title":"\u6784\u5efa\u529f\u80fd\u5305","text":""},{"location":"notes/ros2/#_6","title":"\u6784\u5efa\u6240\u6709\u529f\u80fd\u5305","text":"<pre><code>cd ~/ros2_ws\ncolcon build\n</code></pre>"},{"location":"notes/ros2/#_7","title":"\u6784\u5efa\u6307\u5b9a\u529f\u80fd\u5305","text":"<pre><code>colcon build --packages-select my_cpp_pkg\n</code></pre>"},{"location":"notes/ros2/#_8","title":"\u5237\u65b0\u73af\u5883\u53d8\u91cf","text":"<pre><code>source install/setup.bash\n</code></pre>"},{"location":"notes/ros2/#c_1","title":"C++ \u8282\u70b9","text":""},{"location":"notes/ros2/#_9","title":"\u521b\u5efa\u8282\u70b9\u6587\u4ef6","text":"<p>\u5728 <code>my_cpp_pkg/src/</code> \u4e0b\u65b0\u5efa <code>my_node.cpp</code>\uff1a <pre><code>#include \"rclcpp/rclcpp.hpp\"\n\nclass MyNode : public rclcpp::Node\n{\npublic:\n  MyNode() : Node(\"my_node\")\n  {\n    RCLCPP_INFO(this-&gt;get_logger(), \"\u8282\u70b9\u5df2\u542f\u52a8\");\n  }\n};\n\nint main(int argc, char **argv)\n{\n  rclcpp::init(argc, argv);\n  auto node = std::make_shared&lt;MyNode&gt;();\n  rclcpp::spin(node);\n  rclcpp::shutdown();\n  return 0;\n}\n</code></pre></p>"},{"location":"notes/ros2/#cmakeliststxt","title":"\u4fee\u6539 CMakeLists.txt","text":"<p>\u5728 <code>find_package()</code> \u4e4b\u540e\u6dfb\u52a0\uff1a <pre><code>add_executable(my_node src/my_node.cpp)\nament_target_dependencies(my_node rclcpp)\n\ninstall(TARGETS\n  my_node\n  DESTINATION lib/${PROJECT_NAME}\n)\n</code></pre></p>"},{"location":"notes/ros2/#_10","title":"\u8fd0\u884c\u8282\u70b9","text":"<pre><code>ros2 run my_cpp_pkg my_node\n</code></pre>"},{"location":"notes/ros2/#python_1","title":"Python \u8282\u70b9","text":""},{"location":"notes/ros2/#_11","title":"\u521b\u5efa\u8282\u70b9\u6587\u4ef6","text":"<p>\u5728 <code>my_py_pkg/my_py_pkg/</code> \u4e0b\u65b0\u5efa <code>my_node.py</code>\uff1a <pre><code>import rclpy\nfrom rclpy.node import Node\n\nclass MyNode(Node):\n    def __init__(self):\n        super().__init__('my_node')\n        self.get_logger().info('\u8282\u70b9\u5df2\u542f\u52a8')\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = MyNode()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()\n</code></pre></p>"},{"location":"notes/ros2/#setuppy","title":"\u4fee\u6539 setup.py","text":"<p>\u5728 <code>entry_points</code> \u91cc\u6dfb\u52a0\uff1a <pre><code>entry_points={\n    'console_scripts': [\n        'my_node = my_py_pkg.my_node:main',\n    ],\n},\n</code></pre></p>"},{"location":"notes/ros2/#_12","title":"\u8fd0\u884c\u8282\u70b9","text":"<pre><code>ros2 run my_py_pkg my_node\n</code></pre>"},{"location":"notes/ros2/#serviceparam","title":"\u670d\u52a1\uff08service\uff09\u548c\u53c2\u6570\uff08param\uff09","text":""},{"location":"notes/ros2/#service","title":"service","text":"<pre><code>ros2 service list -t \u67e5\u770b\u670d\u52a1\u5217\u8868\u548c\u63a5\u53e3 \nros2 interface show  ...  \u67e5\u770b\u670d\u52a1\u63a5\u53e3\u7684\u8be6\u7ec6\u5b9a\u4e49\nros2 service call  \u901a\u8fc7\u547d\u4ee4\u884c\u8c03\u7528\u670d\u52a1\n</code></pre>"},{"location":"notes/ros2/#param","title":"param","text":"<pre><code>ros2 param list  \u67e5\u770b\u53c2\u6570\u5217\u8868\nros2 param describe ...  \u67e5\u770b\u6307\u5b9a\u8282\u70b9\u7684\u53c2\u6570\u63cf\u8ff0\nros2 param get ...  \u83b7\u53d6\u8282\u70b9\u7684\u53c2\u6570\u503c\nros2 param set ... \u901a\u8fc7\u547d\u4ee4\u884c\u4fee\u6539\u53c2\u6570\u503c\nros2 param dump ... &gt; ....yaml  \u5c06\u53c2\u6570\u5bfc\u51fa\u5230yaml\nros2 param --help \n</code></pre>"},{"location":"portfolio/","title":"\u4f5c\u54c1\u96c6","text":"<p>\u5185\u5bb9\u5373\u5c06\u5b8c\u5584...</p>"}]}